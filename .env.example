# =====================================================================
# BIZNES MIND AI — namunaviy sozlamalar.
# Mahalliy: Copy-Item .env.example .env   |   Railway: Variables bo'limiga kiriting.
# .env ni HECH KIMGA yubormang.
#
# Kanal, karta, narx va boshqa biznes sozlamalari bu yerda EMAS — ularni botda
# admin sifatida /settings buyrug'i orqali kiritasiz (bazada saqlanadi).
# =====================================================================

# --- MAJBURIY ---
BOT_TOKEN=CHANGE_ME_telegram_bot_token
# Telegram ID ingiz (bir nechta bo'lsa vergul bilan)
ADMIN_IDS=

# --- AI: Gemini (standart) ---
AI_PROVIDER=gemini
# https://aistudio.google.com/apikey dan olinadi
GEMINI_API_KEY=CHANGE_ME_gemini_api_key
# AI Studio dagi joriy model nomi
GEMINI_MODEL=
# Asosiy model band (503) yoki sekin bo'lsa, navbat bilan sinaladigan zaxira modellar
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite
# Gemini "o'ylash" darajasi: none | low | medium | high (low — tezroq javob)
AI_REASONING_EFFORT=low

# --- AI: OpenAI (ixtiyoriy, AI_PROVIDER=openai bo'lsa) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Internet qidiruvi: none | openai_web (faqat OpenAI bilan ishlaydi, alohida pullik)
RESEARCH_PROVIDER=none

# --- AI cheklovlari ---
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8000
# Xarajatni taxminiy hisoblash (USD / 1 million token). 0 = hisoblanmaydi.
AI_INPUT_PRICE_PER_1M=0
AI_OUTPUT_PRICE_PER_1M=0
AI_DAILY_REQUESTS_PER_USER=40
AI_DAILY_REQUESTS_GLOBAL=800
AI_DAILY_BUDGET_USD=0

# --- Spam nazorati va suhbat ---
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=3000
MIN_INTERVIEW_QUESTIONS=6
MAX_INTERVIEW_QUESTIONS=12

# --- Database ---
# Mahalliy: SQLite. Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite+aiosqlite:///./data/biznes_mind.db

# --- Umumiy ---
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
# Railway'da bo'sh qoldiring (loglar konsolda ko'rinadi)
LOG_FILE=logs/bot.log
ENVIRONMENT=development
