# =====================================================================
# BIZNES MIND AI — namunaviy sozlamalar.
# Bu fayldan nusxa oling:  Copy-Item .env.example .env
# So'ng .env ichidagi qiymatlarni o'zingiz to'ldiring. .env ni HECH KIMGA yubormang.
# =====================================================================

# --- Maxfiy kalitlar (faqat .env ichida!) ---
BOT_TOKEN=CHANGE_ME_telegram_bot_token
OPENAI_API_KEY=CHANGE_ME_openai_api_key

# --- OpenAI ---
# Hisobingizda mavjud model nomini yozing (masalan, OpenAI hujjatlaridagi joriy model).
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4000
# Xarajatni taxminiy hisoblash (USD / 1 million token). 0 = hisoblanmaydi.
OPENAI_INPUT_PRICE_PER_1M=0
OPENAI_OUTPUT_PRICE_PER_1M=0
# Internet qidiruvi: none | openai_web  (openai_web alohida pullik!)
RESEARCH_PROVIDER=none

# --- Xarajat va spam nazorati ---
AI_DAILY_REQUESTS_PER_USER=40
AI_DAILY_REQUESTS_GLOBAL=800
# Kunlik taxminiy byudjet (USD). 0 = cheklanmagan (narxlar yuqorida berilgan bo'lsa ishlaydi)
AI_DAILY_BUDGET_USD=0
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=3000
MIN_INTERVIEW_QUESTIONS=6
MAX_INTERVIEW_QUESTIONS=12

# --- Database ---
# Mahalliy test: SQLite. Production: postgresql+asyncpg://user:pass@localhost:5432/biznes_mind
DATABASE_URL=sqlite+aiosqlite:///./data/biznes_mind.db

# --- Adminlar (Telegram ID lar, vergul bilan) ---
ADMIN_IDS=

# --- Pullik g'oyalar kanali ---
# Kanal ID si -100 bilan boshlanadi. Bot kanalda admin bo'lishi kerak.
IDEAS_CHANNEL_ID=
IDEAS_CHANNEL_TITLE=BIZNES MIND g'oyalar kanali
DAILY_IDEAS_COUNT=2
DAILY_RESEARCH_TIME=09:00
TIMEZONE=Asia/Tashkent
# true bo'lsa g'oyalar admin tasdig'isiz kanalga chiqadi
IDEAS_AUTO_PUBLISH=false

# --- To'lov ---
# Bank bildirishnomalari tushadigan yopiq kanal ID si. Bot shu kanalda admin bo'lishi kerak.
PAYMENT_CHANNEL_ID=
CHANNEL_PRICE_UZS=50000
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_TIMEOUT_SECONDS=300
INVITE_LINK_TTL_HOURS=24
# Ixtiyoriy: bankingiz xabari formati boshqacha bo'lsa, summani ajratuvchi regex (1 ta guruh)
PAYMENT_AMOUNT_REGEX=

# --- Umumiy ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ENVIRONMENT=development
